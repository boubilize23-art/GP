# ─────────────────────────────────────────────────────────────────────────────
#  GESTIOPRO — Variables d'environnement Supabase
#  Copiez ce fichier en « .env.local » et complétez les valeurs.
#  (.env.local n'est jamais publié et n'est pas lu par Vercel.)
# ─────────────────────────────────────────────────────────────────────────────

# URL du projet Supabase (Dashboard → Project Settings → API → Project URL)
VITE_SUPABASE_URL=https://bdoodzgwriyqsejspajf.supabase.co

# Clé PUBLISHABLE (ex sb_publishable_...) — celle prévue pour le navigateur
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YyET21izLenA6fkDy4aH9g_comJm1OO

# Adresse de retour après un email de confirmation / réinitialisation de mot de passe.
# Laissez vide en local (l'application prend l'adresse du navigateur).
# En production, indiquez l'adresse publique ET ajoutez-la dans
# Supabase → Authentication → URL Configuration → Redirect URLs
# VITE_AUTH_REDIRECT_URL=https://gestiopro.vercel.app

# ⚠️  N'ajoutez jamais la clé secrète (sb_secret_... ou service_role) ici :
#     elle contourne les politiques RLS et n'a rien à faire dans un navigateur.
